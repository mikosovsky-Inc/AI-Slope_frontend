{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: start",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "uvicorn",
        "main:app",
        "--reload",
        "--port",
        "3000"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VIRTUAL_ENV": "",
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: test",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "pytest",
        "${workspaceFolder}/tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "VIRTUAL_ENV": "",
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$pytest"
      ]
    }
  ]
}